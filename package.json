{
  "name": "shannic",
  "description": "The music app you deserve",
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "bun x cypress run",
    "test:unit": "bun test",
    "lint:fix": "bun x eslint ./src --fix",
    "prettier:fix": "bun x prettier --write ./src",
    "assets:generate": "bun x capacitor-assets generate",
    "android:debug": "bun run build && bun x cap copy android && bun x cap run android",
    "android:copy": "bun run build && bun x cap copy android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/file-transfer": "^2.0.6",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capgo/capacitor-keep-awake": "^8.1.18",
    "@capgo/inappbrowser": "^8.6.14",
    "@iconify-vue/circle-flags": "^1.0.6",
    "@iconify-vue/logos": "^1.0.7",
    "@iconify-vue/material-symbols": "^1.0.50",
    "@ionic/vue": "^9.0.7",
    "@ionic/vue-router": "^9.0.7",
    "@tanstack/vue-virtual": "^3.13.40",
    "@vee-validate/valibot": "^4.15.1",
    "ionicons": "^8.1.0",
    "nanoid": "^6.0.1",
    "node-vibrant": "^4.0.4",
    "pinia": "^4.0.3",
    "rxdb": "^17.6.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "cypress": "^16.1.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "typescript-eslint": "^8.71.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "sass": "^1.105.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  }
}
