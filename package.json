{
  "name": "shannic",
  "description": "The music app you deserve",
  "version": "1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "bun x cypress run",
    "test:unit": "bun test",
    "lint:fix": "bun x eslint ./src --fix",
    "prettier:fix": "bun x prettier --write ./src",
    "assets:generate": "bun x capacitor-assets generate",
    "android:debug": "bun run build && bun x cap copy android && bun x cap run android",
    "android:copy": "bun run build && bun x cap copy android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/file-transfer": "^2.0.5",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/network": "^8.0.1",
    "@capgo/capacitor-keep-awake": "^8.1.15",
    "@capgo/inappbrowser": "^8.6.14",
    "@iconify-vue/circle-flags": "^1.0.5",
    "@iconify-vue/logos": "^1.0.6",
    "@iconify-vue/material-symbols": "^1.0.50",
    "@ionic/vue": "^9.0.2",
    "@ionic/vue-router": "^9.0.2",
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "@tanstack/vue-virtual": "^3.13.36",
    "ionicons": "^8.1.0",
    "node-vibrant": "^4.0.4",
    "pinia": "^4.0.3",
    "rxdb": "^17.5.0",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "cypress": "^16.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "typescript-eslint": "^8.69.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "sass": "^1.104.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
